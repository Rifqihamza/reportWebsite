---
import UseReportConfigHookEffect from "../../../../hooks/shared/useReportConfig";
import ReportFilterContainer from "./ReportFilterContainer";
import LineChartComponent from "./outputs/LineChartComponent";
import PieChartComponent from "./outputs/PieChartComponent";
import PercentComponent from "./outputs/PercentComponent";
import InsightsComponent from "./outputs/InsightsComponent";
import UseReportDataHookEffect from "../../../../hooks/shared/useReportData";
import { UseReportStatisticsEffect } from "../../../../hooks/pages/Statistics/useReportStatisticsHook";
---

<UseReportConfigHookEffect client:visible useAllCampus />
<UseReportDataHookEffect client:visible />
<UseReportStatisticsEffect client:visible />
<div class="flex flex-col gap-4 mx-4 mt-2 opacity-(--tab-2-opacity) [position:var(--tab-2-position)]">
  <h1 class="text-3xl text-white">Report Statistics</h1>
  <ReportFilterContainer />
  <div class="w-full px-4 pb-2 pt-6 rounded-2xl bg-[#2b3440] border border-white shadow">
    <div class="px-4 w-full flex flex-col items-start gap-2">
      <h1 class="font-bold text-xl text-white">Grafik Laporan Temuan</h1>
    </div>
    {/* Line Chart */}
    <LineChartComponent client:idle />
  </div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 w-full">
    {/* Kiri: Pie Chart Kategori dan Status */}
    <div class="flex flex-col gap-4">
      {/* Pie Chart Kategori */}
      <div class="w-full h-full px-6 py-4 text-center rounded-2xl flex flex-col items-center **:text-white! border border-white bg-[#2b3440] shadow">
        <h1 class="font-bold uppercase tracking-wider">Kategori</h1>
        <PieChartComponent client:visible pieType="category" />
      </div>

      {/* Pie Chart Status */}
      <div class="w-full h-full px-6 py-4 text-center rounded-2xl flex flex-col items-center **:text-white! border border-white bg-[#2b3440] shadow">
        <h1 class="font-bold uppercase tracking-wider">Status</h1>
        <PieChartComponent client:visible pieType="status" />
      </div>
    </div>

    <div class="flex flex-col gap-4 w-full">
      {/* Grid untuk 2 PersenComp */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <PercentComponent percentType="category" />
        <PercentComponent percentType="status" />
      </div>

      {/* Container Insight di bawahnya */}
      <div class="w-full h-full px-6 py-4 rounded-2xl flex flex-col items-center bg-[#2b3440] border border-white shadow">
        <h2 class="text-white font-semibold uppercase tracking-wider text-md mb-2">Insights</h2>
        <InsightsComponent client:visible />
      </div>
    </div>
  </div>
</div>
