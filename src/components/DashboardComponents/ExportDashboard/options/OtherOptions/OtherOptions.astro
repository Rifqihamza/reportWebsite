---
import UseReportDataHookEffect from "../../../../../hooks/shared/useReportData";
import OtherOptionsForm from "./OtherOptionsForm";
---

<UseReportDataHookEffect client:visible />
<div class="bg-[#374151] w-full h-fit rounded-xl px-3">
  <div class="w-full h-full flex flex-col gap-2 md:flex-row md:gap-0 justify-between px-4 py-5">
    <div class="w-full">
      <h1 class="text-xl lg:text-2xl font-semibold text-white">Other Options</h1>
      <span class="text-md lg:text-lg text-white flex flex-row items-center gap-3">
        Opsi lain untuk pengaturan lebih lanjut
        <i class="pi pi-arrow-right hidden! md:inline!"></i>
      </span>
    </div>
    <div class="flex flex-col mt-6 md:mt-0 items-center gap-6 w-full h-full">
      <OtherOptionsForm client:only />
    </div>
  </div>
</div>
