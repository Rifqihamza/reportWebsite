---
import RowOptionsListBox from "./RowOptionsListBox";
---

<div class="bg-[#374151] w-full h-fit rounded-xl px-3">
  <div class="flex flex-col md:flex-row justify-between px-4 py-5">
    <div class="w-full">
      <h1 class="text-xl lg:text-2xl font-semibold text-white">Row Options</h1>
      <span class="w-max text-md lg:text-lg text-white flex flex-row items-center gap-3">
        Opsi baris data yang akan di ekspor
        <i class="pi pi-arrow-right hidden! md:inline!"></i>
      </span>
    </div>
    <div class="w-full flex flex-col justify-center items-center">
      <RowOptionsListBox client:only />
    </div>
  </div>
</div>
