---
import OutputOptionsList from "./OutputOptionsList";
---

<div class="bg-[#374151] w-full h-fit rounded-xl px-3">
  <div class="flex flex-col gap-2 md:flex-row md:gap-0 justify-between px-4 py-5">
    <div class="w-full">
      <h1 class="text-xl lg:text-2xl font-semibold text-white">Output Options</h1>
      <span class="text-md lg:text-lg text-white flex flex-row items-center gap-3">
        Opsi output tipe file
        <i class="pi pi-arrow-right hidden! md:inline!"></i>
      </span>
    </div>
    <div class="flex flex-col md:flex-row items-center gap-2 md:gap-4 w-full">
      <OutputOptionsList client:only />
    </div>
  </div>
</div>
