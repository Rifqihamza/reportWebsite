---
import EditProfileModal from "./EditProfileModal";
import SettingForm from "./SettingForm";
---

<section class="flex md:flex-row flex-col gap-4 w-full rounded-2xl p-6 opacity-(--tab-5-opacity) [position:var(--tab-5-position)]">
  <div class="w-full flex flex-row items-center gap-8 bg-[#2b3440] shadow shadow-gray-500 rounded-2xl px-8 py-6">
    <div class="ring-2 ring-[#9CA3AF]/50 rounded-full p-4">
      <i class="pi pi-user p-12! text-4xl!" style={{ color: "#9CA3AF" }}></i>
    </div>
    <ul class="flex flex-col w-full text-[#9CA3AF]">
      <SettingForm client:visible />
      <EditProfileModal client:only />
    </ul>
  </div>
</section>
