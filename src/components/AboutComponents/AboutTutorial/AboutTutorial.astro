---
import TimelineComponent from "./TutorialComponent/Tutorial";
---

<section
  id="tutorial"
  class="w-full min-h-[70vh] gap-2 flex flex-col items-center justify-center"
  aria-labelledby="tutorial-title"
>
  <header class="text-center mb-10">
    <h2 id="tutorial-title" class="text-2xl md:text-3xl leading-tight">
      How To Use <br class="inline md:hidden" />
      <b class="text-[var(--primary)] uppercase">e-Lapor</b>?
    </h2>
  </header>

  <article class="w-full max-w-5xl mx-auto">
    <TimelineComponent client:load />
  </article>
</section>
