---
import TimelineComponent from "./TutorialComponent/Tutorial";
---

<section id="tutorial" class="w-full max-w-6xl min-h-[90vh] px-2 mx-auto flex flex-col items-start justify-center" aria-labelledby="tutorial-title">
      <header class="text-left mb-10">
            <h2 id="tutorial-title" class="text-2xl md:text-3xl leading-tight">
                  How To Use
                  <b class="text-(--primary) uppercase">e-Lapor</b>?
            </h2>
            <p class="text-md md:text-lg font-normal">Cara menggunakan e-Lapor</p>
      </header>

      <article class="w-full">
            <TimelineComponent client:only />
      </article>
</section>
