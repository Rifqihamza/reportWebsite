---
import FaqList from "./FaqList/FaqList";
---

<section
  id="faq"
  class="w-full max-w-6xl min-h-[90vh] mx-auto flex items-center justify-center"
  aria-labelledby="faq-title"
>
  <div class="flex flex-col justify-center items-center px-3 w-full">
    <header class="flex flex-row items-center justify-between w-full">
      <div>
        <h2 id="faq-title" class="text-2xl md:text-4xl font-semibold">FAQ</h2>
        <p class="text-md md:text-lg font-normal pb-6">
          Frequently Asked Questions
        </p>
      </div>
      <div>
        <i
          class="pi pi-question-circle text-4xl!"
          aria-hidden="true"
          title="FAQ icon"></i>
      </div>
    </header>

    <section aria-label="Daftar pertanyaan umum" class="w-full">
      <FaqList client:only />
    </section>
  </div>
</section>
