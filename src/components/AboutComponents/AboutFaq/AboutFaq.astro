---
import FaqList from "./FaqList/FaqList";
---

<div
  class="px-10 md:px-50 bg-[#2b3440] py-[20vh] flex flex-col items-center justify-center"
>
  <div class="p-4 rounded-2xl w-[90vw] md:w-[70vw] h-full -translate-y-4">
    <h1
      class="text-[#F2E5BF] text-2xl md:text-5xl text-center font-semibold"
    >
      FAQ
    </h1>
    <p class="text-white text-md md:text-xl text-center font-normal pb-6">
      Frequently Asked Question
    </p>
    <FaqList client:only />
  </div>
</div>
