---
import FaqList from "./FaqList/FaqList";
---

<div
  class="px-10 md:px-50 pb-52 bg-zinc-800 h-max md:h-[80vh] flex flex-col items-center"
>
  <div class="text-[#F2E5BF] p-4 rounded-2xl w-[90vw] md:w-[70vw] mt-4">
    <h1 class="text-2xl md:text-5xl text-center font-semibold pt-10">FAQ</h1>
    <p class="text-md md:text-xl text-center font-normal pb-6 text-white">
      Frequently Asked Question
    </p>
    <FaqList client:only />
  </div>
</div>
