---
import FaqList from "./FaqList/FaqList";
---

<div
  class="px-10 md:px-50 pb-52 bg-[#2C2C2C] h-max md:h-[70vh] flex flex-col items-center"
>
  <div class="p-4 rounded-2xl w-[90vw] md:w-[70vw] mt-4">
    <h1
      class="text-[#DCD7C9] text-2xl md:text-5xl text-center font-semibold pt-10"
    >
      FAQ
    </h1>
    <p class="text-white text-md md:text-xl text-center font-normal pb-6">
      Frequently Asked Question
    </p>
    <FaqList client:only />
  </div>
</div>
