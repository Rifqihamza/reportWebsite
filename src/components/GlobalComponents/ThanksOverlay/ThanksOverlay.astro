---
import ThanksOverlayTrigger from "./ThanksOverlayTrigger";
import LogoSekolah from "../../../assets/images/logoSekolah.png";
import HeroImage from "../../../../public/img/9086589-removebg-preview.png";
import ThanksCloseButton from "./ThanksCloseButton";

import { Image } from "astro:assets";
---

<div
  class="fixed inset-0 z-100 w-full h-full
         bg-black/0 backdrop-blur-none
         opacity-0 pointer-events-none
         transition-all duration-500 ease-out
         has-[.show-thanks]:bg-black/50
         has-[.show-thanks]:backdrop-blur-sm
         has-[.show-thanks]:opacity-100
         has-[.show-thanks]:pointer-events-auto
         flex justify-center items-center p-4"
>
  <ThanksOverlayTrigger client:load />

  <section class="fixed inset-0 flex items-center justify-center p-4">
    <div
      class="bg-[#F2E5BF] shadow shadow-white w-full max-w-3xl max-h-screen overflow-y-auto p-4 md:p-6 rounded-xl space-y-4 relative"
    >
      <h1
        class="font-bold uppercase text-lg md:text-xl text-white bg-[#257180] px-4 py-3 rounded-xl text-center"
      >
        Terima Kasih Telah Melapor!
      </h1>

      <div class="flex flex-col-reverse md:flex-row justify-center">
        <div class="flex flex-col gap-4 w-full md:w-1/2">
          <div
            class="px-4 py-4 rounded-xl text-justify flex flex-col gap-4 items-center justify-center"
          >
            <Image src={LogoSekolah} class="w-24 h-auto" alt="Logo Sekolah" />
            <p
              class="text-gray-800 text-base md:text-lg font-medium text-center md:text-justify"
            >
              Kami menghargai partisipasi Anda dalam melaporkan temuan ini.
              Bersama kita wujudkan lingkungan yang lebih baik.
            </p>
          </div>
          <ThanksCloseButton client:load />
        </div>

        <div class="w-full md:w-1/2 flex justify-center">
          <Image
            src={HeroImage}
            class="w-full md:w-[90%] px-4 py-2 bg-[#257180] h-auto rounded-xl"
            alt="Thanks Image"
          />
        </div>
      </div>
    </div>
  </section>
</div>
