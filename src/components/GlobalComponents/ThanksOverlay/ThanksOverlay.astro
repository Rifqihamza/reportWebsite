---
import ThanksOverlayTrigger from "./ThanksOverlayTrigger";
import LogoSekolah from "../../../../public/img/logoSekolah.png";
import HeroImage from "../../../../public/img/9086589-removebg-preview.png";
import { Image } from "astro:assets";
---

<div
  class="duration-500 overflow-hidden flex justify-center items-center p-4 fixed top-[-100%] left-1/2 -translate-x-1/2 -translate-y-1/2 has-[.show-thanks]:top-0 z-100 w-full h-full bg-black/50 backdrop-blur-sm has-[.show-thanks]:translate-y-0 has-[.show-thanks]:opacity-100 has-[.show-thanks]:pointer-events-auto"
>
  <ThanksOverlayTrigger client:load />

  <section class="fixed inset-0 flex items-center justify-center p-4">
    <div
      class="bg-[#1f324d] shadow shadow-white w-full max-w-3xl max-h-screen overflow-y-auto p-4 md:p-6 rounded-xl space-y-4 relative"
    >
      <h1
        class="font-bold uppercase text-lg md:text-xl text-white bg-[#7FA1C3] px-4 py-3 rounded-xl text-center"
      >
        Terima Kasih Telah Melapor!
      </h1>

      <div class="flex flex-col-reverse md:flex-row justify-center gap-4">
        <div class="flex flex-col gap-4 w-full md:w-1/2">
          <div
            class="px-4 py-4 bg-[#7FA1C3] rounded-xl text-justify flex flex-col gap-4 items-center justify-center"
          >
            <Image src={LogoSekolah} class="w-24 h-auto" alt="Logo Sekolah" />
            <p
              class="text-white text-base md:text-lg font-medium text-center md:text-justify"
            >
              Kami menghargai partisipasi Anda dalam melaporkan temuan ini.
              Bersama kita wujudkan lingkungan yang lebih baik.
            </p>
          </div>

          <button
            class="px-4 py-4 bg-[#7FA1C3] text-white rounded-xl uppercase tracking-wider font-bold cursor-pointer"
          >
            Selesai
          </button>
        </div>

        <div class="w-full md:w-1/2 flex justify-center">
          <Image
            src={HeroImage}
            class="w-full md:w-[90%] px-4 py-2 bg-[#7FA1C3] h-auto rounded-xl"
            alt="Thanks Image"
          />
        </div>
      </div>
    </div>
  </section>
</div>
