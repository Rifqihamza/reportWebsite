---

import ThanksOverlayTrigger from "./ThanksOverlayTrigger"
import ThumbsUpImage from "../../../public/img/thumbsUp.png";
import { Image } from "astro:assets";

---

<div class="overflow-hidden flex justify-center items-center p-10 fixed top-[-100%] left-1/2 -translate-x-1/2 -translate-y-1/2 has-[.show-thanks]:top-1/2 bg-[#93BFCF] border-white border-3 rounded-xl z-100 w-[70vh] max-w-[min(750px,_70vw)] h-[70vh]">
    <ThanksOverlayTrigger />
    <h1 class="text-center text-xl font-thin">Terima kasih sudah melaporkan temuan mu!</h1>
    <Image src={ThumbsUpImage} alt="Thumbs Up Image" class="absolute bottom-10 left-10" />
</div>