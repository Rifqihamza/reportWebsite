---
import HelpButton from "../../components/GlobalComponents/HelpButton/HelpButton";
import LoginFormComponent from "../../components/LoginComponents/LoginForm/LoginFormComponent";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <HelpButton client:load />
  <div class="flex justify-center items-center w-full h-screen">
    <div
      class="relative bg-[#F2E5BF] border-4 border-[#CB6040] border-dashed p-6 rounded-3xl max-w-3xl w-full h-fit mx-8"
    >
      <div
        class="px-7 py-6 rounded-2xl text-white bg-[#257180] absolute inset-x-1/8 -translate-y-[5rem] flex flex-row items-center justify-center"
      >
        <!-- Label Login -->
        <div class="text-center">
          <h1 class="font-bold text-lg">Login Page</h1>
          <p class="text-[14px]">Please Login First!</p>
        </div>
      </div>
      <form method="POST" action="" class="mt-8">
        <LoginFormComponent client:load />
      </form>
    </div>
  </div>
</Layout>
