---
import LoginFormComponent from "../../components/LoginComponents/LoginForm/LoginFormComponent";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <div class="flex justify-center items-center w-full h-screen">
    <div class="bg-white p-6 rounded-3xl max-w-3xl w-full mx-8">
      <form method="POST" action="">
        <div
          class="px-4 py-3 bg-[#1f324d] rounded-2xl text-white flex flex-row items-center justify-between"
        >
          <!-- Label Login -->
          <div>
            <h1 class="font-bold text-lg">Login Page</h1>
            <p class="text-[14px]">Please Login First!</p>
          </div>
          <img src="/img/logoSekolah.png" class="w-10 h-auto" alt="" />
        </div>

        <LoginFormComponent client:load />
      </form>
    </div>
  </div>
</Layout>
