---
import Layout from "../layouts/Layout.astro";
import AboutNavbar from "../components/AboutComponents/AboutNavbar/AboutNavbar";
import DirectButton from "../components/GlobalComponents/DirectButton/DirectButton";
import FaqList from "../components/AboutComponents/FaqList/FaqList";
import AboutFooter from "../components/AboutComponents/AboutFooter/AboutFooter.astro";
import AboutFeedback from "../components/AboutComponents/AboutFeedback/AboutFeedback.astro";
---

<Layout pageType="faq">
  <AboutNavbar client:load />
  <div
    class="overflow-hidden relative bg-white text-black py-2 px-10 md:px-30 w-full min-h-[90vh] md:min-h-[100vh] flex flex-col md:flex-row gap-4 md:gap-14 justify-evenly md:justify-between items-center transition-all duration-400"
  >
    <div
      class="w-full h-full bg-slate-900 absolute md:top-0 md:left-1/2 md:bottom-0 -bottom-[30rem] md:rounded-full rounded-[6rem]"
    >
    </div>
    <!-- Short Desc -->
    <div class="z-10 text-[#1f324d]">
      <h1 class="text-4xl md:text-5xl text-center md:text-left font-extralight">
        e-Lapor
      </h1>
      <p class="text-md md:text-lg text-center md:text-left font-thin pb-4">
        What is e-Lapor?
      </p>
      <p class="text-md md:text-xl font-thin max-w-md text-justify">
        Platform ini dirancang untuk memfasilitasi pelaporan temuan di
        lingkungan sekolah dan mengelolanya dalam satu sistem terintegrasi, guna
        mendukung melihat, menganalisis dan pengambilan keputusan berbasis data.
      </p>
      <div
        class="flex items-center md:justify-start justify-center mt-4 md:mt-5"
      >
        <DirectButton label="Laporkan Sekarang!" client:only />
      </div>
    </div>

    <!-- Img -->
    <div
      class="w-[70vw] h-[40vh] md:w-[30vw] md:h-[40vh] bg-[#1f324d] shadow-lg shadow-gray-600 py-6 px-2 rounded-xl relative"
    >
      <div>
        <span class="w-3 h-3 bg-red-600 rounded-full absolute top-2 left-2"
        ></span>
        <span class="w-3 h-3 bg-yellow-400 rounded-full absolute top-2 left-6"
        ></span>
        <span class="w-3 h-3 bg-green-500 rounded-full absolute top-2 left-10"
        ></span>
        <span
          class="text-center text-white text-sm absolute top-1 left-0 right-0"
          >Report Form</span
        >
      </div>
      <img
        src="/img/reportScreenshot.png"
        class="w-fit h-full mx-auto object-cover aspect-square rounded-xl"
        alt=""
      />
    </div>
  </div>

  <div
    class="bg-slate-900 text-white px-10 md:px-34 py-10 w-full min-h-[70vh] flex flex-col gap-2 items-center"
  >
    <h1 class="text-2xl md:text-4xl text-center font-thin pt-4">
      Cara menggunakan <br class="inline md:hidden" />e-Lapor
    </h1>
    <p class="text-md md:text-xl text-center font-thin pb-10">
      How to use e-Lapor
    </p>
    <div class="flex flex-col md:flex-row md:gap-8 gap-16 font-normal">
      <!-- As Student -->
      <div
        class="bg-white/5 backdrop-blur-lg border border-white/50 text-white shadow shadow-white rounded-2xl flex flex-col p-10 w-full max-w-md relative"
      >
        <div
          class="bg-[#1f324d] border border-white/50 rounded-full flex items-center justify-center w-20 h-20 mx-auto absolute -top-10 left-0 right-0"
        >
          <i class="pi pi-user text-white text-2xl!"></i>
        </div>
        <div>
          <h1 class="text-center text-2xl mt-3">as Student</h1>
          <ol class="list-decimal text-md space-y-4 mt-3 text-sm md:text-lg">
            <li>
              Siswa mengklik tombol login di kanan atas yang kemudian dikirim ke
              halaman login.
            </li>
            <li>
              Siswa masukkan username dan password yang telah diberikan
              sebelumnya oleh guru. Jika sudah, siswa akan masuk ke form laporan
            </li>
            <li>
              Siswa dapat masukkan data laporan yang ditemukan langsung di form
              tersebut. Lalu, siswa dapat menekan tombol "submit"
            </li>
          </ol>
        </div>
      </div>
      <!-- As Admin -->
      <div
        class="bg-white/5 backdrop-blur-lg border border-white/50 text-white shadow shadow-white rounded-2xl flex flex-col p-10 w-full max-w-md relative"
      >
        <div
          class="bg-[#1f324d] border border-white/50 rounded-full flex items-center justify-center w-20 h-20 mx-auto absolute -top-10 left-0 right-0"
        >
          <i class="pi pi-user-plus text-white text-2xl!"></i>
        </div>
        <div>
          <h1 class="text-center text-2xl mt-3">as Admin</h1>
          <ol class="list-decimal text-md space-y-4 mt-3 text-sm md:text-lg">
            <li>
              Admin mengklik tombol login di kanan atas dan akan pergi ke
              halaman login.
            </li>
            <li>
              Admin masukkan username dan password khusus admin yang telah
              diberikan sebelumnya. Jika sudah, admin akan masuk ke dashboard
              admin.
            </li>
            <li>
              Admin dapat melihat, mengedit, dan mengubah status dari laporan
              yang telah di-submit user di tab "Table Report".
            </li>
            <li>
              Admin juga dapat menganalisis data laporan di tab "Statistics"
              untuk melihat data yang sudah diolah.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </div>
  <div class="py-10 px-10 md:px-50 bg-white h-full">
    <div class="text-[#1f324d] p-4 rounded-2xl">
      <h1 class="text-2xl md:text-5xl text-center font-thin pt-10">FAQ</h1>
      <p class="text-md md:text-xl text-center font-thin pb-10">
        Frequently Asked Question
      </p>
      <FaqList client:only />
    </div>
  </div>
  <AboutFeedback />
  <AboutFooter />
</Layout>

<style is:global>
  body {
    background-color: #e3e3e3;
  }
</style>
