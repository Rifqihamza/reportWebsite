---
import Layout from "../layouts/Layout.astro";
import AboutNavbar from "../components/AboutComponents/AboutNavbar/AboutNavbar";
import AboutFooter from "../components/AboutComponents/AboutFooter/AboutFooter.astro";
import AboutFeedback from "../components/AboutComponents/AboutFeedback/AboutFeedback.astro";
import AboutFaq from "../components/AboutComponents/AboutFaq/AboutFaq.astro";
import AboutTutorial from "../components/AboutComponents/AboutTutorial/AboutTutorial.astro";
import AboutMain from "../components/AboutComponents/AboutMain/AboutMain.astro";
---

<Layout pageType="faq">
  <AboutNavbar client:load />
  <AboutMain />
  <AboutTutorial />
  <AboutFaq />
  <AboutFeedback />
  <AboutFooter />
</Layout>

  <style is:global>
    body {
      background-color: #e3e3e3;
    }
  </style>
</Layout>
