---
// Pages
import WelcomePage from "../../components/DashboardComponents/WelcomeDashboard/WelcomePage";
import ReportTablePage from "../../components/DashboardComponents/TableDashboard/ReportTablePage";
import ReportStatisticsPage from "../../components/DashboardComponents/StatisticsDashboard/ReportStatisticsDashboard/ReportStatisticsPage";
import PICStatisticsPage from "../../components/DashboardComponents/StatisticsDashboard/PICStatisticsDashboard/PICStatisticsPage";
import ExportPage from "../../components/DashboardComponents/ExportDashboard/ExportPage";
import UsersPage from "../../components/DashboardComponents/UsersDashboard/UsersPage";
import SettingPage from "../../components/DashboardComponents/SettingDashboard/SettingPage";

// Others
import Layout from "../../layouts/Layout.astro";
import SidebarDashboard from "../../components/DashboardComponents/SidebarAdmin/SidebarAdmin";
import UseUserDataHookEffect from "../../hooks/shared/useUserData";
import UseReportConfigHookEffect from "../../hooks/shared/useReportConfig";
import SidebarToggle from "./DashboardPage/_SideBarToggle";
import VersionTracker from "../../components/GlobalComponents/VersionTracker/VersionTracker";
---

<Layout pageType="dashboard">
  <VersionTracker client:only />
  <UseUserDataHookEffect client:load />
  <UseReportConfigHookEffect client:load useAllCampus />

  <section class="flex flex-col h-screen w-screen absolute left-0 top-0">
    <!-- Header -->
    <header class="w-full px-4 py-4 sticky top-0 box-border headerDashboard">
      <SidebarToggle client:load />
      <div
        class="hidden lg:flex flex-row-reverse items-center justify-between gap-4"
      >
        <img
          src="/img/logoSekolah.png"
          class="hidden md:block w-8 h-8 ring-2 ring-white rounded-full"
          alt="Logo Sekolah"
        />
        <h1 class="font-semibold text-[#DCD7C9]">E-Lapor Dashboard</h1>
      </div>
    </header>
    <div class="flex h-full overflow-y-auto">
      <!-- Sidebar -->
      <SidebarDashboard client:load />
      <!-- Main Pages Scrollable -->
      <main class="flex-1 overflow-y-auto p-2 bg-[#1A1D24] lg:rounded-tl-2xl">
        <WelcomePage client:load />
        <ReportTablePage client:only />
        <ReportStatisticsPage client:only />
        <PICStatisticsPage client:only />
        <ExportPage client:only />
        <UsersPage client:only />
        <SettingPage client:only />
      </main>
    </div>
  </section>
</Layout>
