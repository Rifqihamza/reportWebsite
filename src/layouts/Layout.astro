---
import "../styles/global.css";
import "primereact/resources/themes/saga-blue/theme.css"; // atau tema lain
import "primereact/resources/primereact.min.css"; // komponen core
import "primeicons/primeicons.css"; // icon

import VerifyAuthentication from "../components/GlobalComponents/VerifyAuthentication";
import ToastMessage from "../components/ToastMessage/ToastMessage";

import SpeedInsights from "@vercel/speed-insights/astro";

const { pageType = "form" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />

    <link rel="icon" href="/img/logoSekolah.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Report Website | SMK Mitra Industri MM2100</title>
  </head>
  <body class={pageType === "dashboard" ? "bg-dashboard" : "bg-form"}>
    {
      pageType === "form" && (
        <div>
          <div class="wave" />
          <div class="wave" />
          <div class="wave" />
        </div>
      )
    }

    <VerifyAuthentication client:load />
    <slot />
    <ToastMessage client:only />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"
    ></script>
    <SpeedInsights />
  </body>
</html>
