---
import "../styles/global.css";

import SpeedInsights from "@vercel/speed-insights/astro";

const { pageType = "form" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="description" content="Data manager website for reports that can be used by students in Mitra Industri Vocational HighSchool" />
    <link rel="icon" href="/img/logoSekolah.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Report Website | SMK Mitra Industri MM2100</title>
  </head>
  <body class={pageType === "dashboard" ? "bg-dashboard" : (pageType === "form" ? "bg-form" : "")}>
    {
      pageType === "form" && (
        <div>
          <div class="wave" />
          <div class="wave" />
          <div class="wave" />
        </div>
      )
    }

    <slot />
  </body>
</html>

<SpeedInsights />