generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// Enum
enum ActivityType {
  UpdateUser
  LoginUser
  LogoutUser
  CreateUser
  CreateReport
  GetReport
  UpdateReport
  DeleteReport
  CreatePIC
}

enum AccountType {
  Admin
  Guru
  Siswa
  Vendor
  Tukang
}

enum ReportType {
  VR
  Safety
  Abnormality
}

enum ReportStatus {
  NotStarted
  InProcess
  Complete
  Hold
}

enum Campus {
  MM
  PD
  PATI
  AMI
  MOJO
  SM
  BBL
  KLTN
}

// Database model
model Users {
  id                  String      @id @default(uuid())
  username            String      @unique
  lowercased_username String      @unique
  password            String
  role                AccountType

  created_at DateTime @default(now())
  inactive   Boolean  @default(false)

  // Relation
  recorded_activities RecordedActivity[]
  recorded_reports    Report[]

  responsible_location UserResponsibleLocation[]
  notifications        Notification[]
}

model Report_Location {
  id          String @id @default(uuid())
  location    String @unique
  campus_name Campus
  pic_name    String

  created_at DateTime @default(now())

  // Relation
  reports_location Report[]
  responsible_user UserResponsibleLocation[]

  @@unique([location, pic_name])
}

model UserResponsibleLocation {
  id String @id @default(uuid())

  // Relation
  report_location Report_Location @relation(fields: [location], references: [location])
  location        String

  responsible_user      Users  @relation(fields: [responsible_user_name], references: [username])
  responsible_user_name String
}

model Report {
  id                 String       @id @default(uuid())
  submitted_by       String       @db.VarChar(30)
  message            String       @db.VarChar(200)
  type               ReportType
  follow_up          AccountType?
  follow_up_name     String?      @db.VarChar(30)
  status             ReportStatus @default(NotStarted)
  image              String?
  image_after_finish String?
  detail_location    String?      @db.VarChar(200)
  campus             Campus

  created_at DateTime @default(now())

  report_date DateTime  @default(now())
  due_date    DateTime?

  // Relations
  report_location Report_Location @relation(references: [location, pic_name], fields: [location_name, pic_name], onDelete: Cascade)
  location_name   String
  pic_name        String

  account_used Users  @relation(references: [username], fields: [account_name], onDelete: Cascade)
  account_name String
}

model VerifiedCaptcha {
  id        String   @id @default(uuid())
  token     String   @unique
  expire_at DateTime @default(now())
}

model RecordedActivity {
  id            String       @id @default(uuid())
  ip_address    String
  url           String
  activity_type ActivityType

  created_at DateTime @default(now())

  // Relations
  account      Users  @relation(references: [username], fields: [account_name], onDelete: Cascade)
  account_name String
}

model Notification {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  title      String
  message    String
  isNew      Boolean  @default(false)

  // Relations
  account      Users  @relation(fields: [account_name], references: [username], onDelete: Cascade, onUpdate: Cascade)
  account_name String
}
