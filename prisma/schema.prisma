generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model recordedactivity {
  id            String                         @id
  message       String
  url           String
  activity_type recordedactivity_activity_type
  created_at    DateTime                       @default(now())
  account_name  String
  users         users                          @relation(fields: [account_name], references: [username], onDelete: Cascade, map: "RecordedActivity_account_name_fkey")

  @@index([account_name], map: "RecordedActivity_account_name_fkey")
}

model report {
  id                 String            @id
  submitted_by       String            @db.VarChar(30)
  message            String            @db.VarChar(200)
  type               report_type
  follow_up          report_follow_up?
  follow_up_name     String?           @db.VarChar(30)
  status             report_status     @default(NotStarted)
  image              String?           @db.LongText
  detail_location    String?           @db.VarChar(200)
  campus             report_campus
  created_at         DateTime          @default(now())
  report_date        DateTime          @default(now())
  due_date           DateTime?
  pic_id             String?
  location_id        String?
  pic_name           String?
  location_name      String?
  account_name       String
  image_after_finish String?
  users              users             @relation(fields: [account_name], references: [username], onDelete: Cascade, map: "Report_account_name_fkey")
  report_location    report_location?  @relation(fields: [location_id, location_name], references: [id, location], map: "Report_location_id_location_name_fkey")
  report_pic         report_pic?       @relation(fields: [pic_id, pic_name], references: [id, name], map: "Report_pic_id_pic_name_fkey")

  @@index([account_name], map: "Report_account_name_fkey")
  @@index([location_id, location_name], map: "Report_location_id_location_name_fkey")
  @@index([pic_id, pic_name], map: "Report_pic_id_pic_name_fkey")
}

model report_location {
  id          String                      @id
  location    String
  campus_name report_location_campus_name
  created_at  DateTime                    @default(now())
  report      report[]

  @@unique([id, location], map: "Report_Location_id_location_key")
  @@unique([location, campus_name], map: "Report_Location_location_campus_name_key")
}

model report_pic {
  id          String                 @id
  name        String
  campus_name report_pic_campus_name
  created_at  DateTime               @default(now())
  report      report[]

  @@unique([id, name], map: "Report_PIC_id_name_key")
  @@unique([name, campus_name], map: "Report_PIC_name_campus_name_key")
}

model users {
  id                  String             @id
  username            String             @unique(map: "Users_username_key")
  password            String
  role                users_role
  created_at          DateTime           @default(now())
  inactive            Boolean            @default(false)
  lowercased_username String             @unique(map: "Users_lowercased_username_key")
  recordedactivity    recordedactivity[]
  report              report[]
}

model verifiedcaptcha {
  id        String   @id
  token     String   @unique(map: "VerifiedCaptcha_token_key")
  expire_at DateTime @default(now())
}

enum report_pic_campus_name {
  MM
  PD
  PATI
  AMI
  MOJO
  SM
  BBL
  KLTN
}

enum report_location_campus_name {
  MM
  PD
  PATI
  AMI
  MOJO
  SM
  BBL
  KLTN
}

enum recordedactivity_activity_type {
  UpdateUser
  LoginUser
  LogoutUser
  CreateUser
  CreateReport
  GetReport
  UpdateReport
  DeleteReport
  CreatePIC
}

enum report_type {
  VR
  Safety
  Abnormality
}

enum users_role {
  Admin
  Guru
  Siswa
  Vendor
  Tukang
}

enum report_follow_up {
  Admin
  Guru
  Siswa
  Vendor
  Tukang
}

enum report_status {
  NotStarted
  InProcess
  Complete
  Hold
}

enum report_campus {
  MM
  PD
  PATI
  AMI
  MOJO
  SM
  BBL
  KLTN
}
