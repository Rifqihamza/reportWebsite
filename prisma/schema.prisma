generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enum
enum ActivityType {
  UpdateUser
  LoginUser
  LogoutUser
  CreateUser
  CreateReport
  GetReport
  UpdateReport
  DeleteReport
  CreatePIC
}

enum AccountType {
  Admin
  Guru
  Siswa
  Vendor
  Tukang
}

enum ReportType {
  VR
  Safety
  Abnormality
}

enum ReportStatus {
  NotStarted
  InProcess
  Complete
  Hold
}

enum Campus {
  MM
  PD
  PATI
  AMI
  MOJO
  SM
  BBL
  KLTN
}

// Database model
model Users {
  id                  String      @id @default(uuid())
  username            String      @unique
  lowercased_username String      @unique
  password            String
  role                AccountType

  created_at DateTime @default(now())
  inactive   Boolean  @default(false)

  // Relation
  recorded_activities RecordedActivity[]
}

model Report_PIC {
  id          String @id @default(uuid())
  name        String
  campus_name Campus

  created_at DateTime @default(now())

  // Relation
  reports Report[]

  @@unique([name, campus_name])
  @@unique([id, name])
}

model Report_Location {
  id          String @id @default(uuid())
  location    String
  campus_name Campus

  created_at DateTime @default(now())

  // Relation
  reports Report[]

  @@unique([location, campus_name])
  @@unique([id, location])
}

model Report {
  id              String       @id @default(uuid())
  submitted_by    String       @db.VarChar(30)
  message         String       @db.VarChar(200)
  type            ReportType
  follow_up       AccountType?
  follow_up_name  String?      @db.VarChar(30)
  status          ReportStatus @default(NotStarted)
  image           String?
  detail_location String?      @db.VarChar(200)
  campus          Campus

  created_at DateTime @default(now())

  report_date DateTime  @default(now())
  due_date    DateTime?

  // Relations
  responsible_pic Report_PIC? @relation(references: [id, name], fields: [pic_id, pic_name], onDelete: SetNull)
  pic_id          String?
  pic_name        String?

  report_location Report_Location? @relation(references: [id, location], fields: [location_id, location_name], onDelete: SetNull)
  location_id     String?
  location_name   String?
}

model VerifiedCaptcha {
  id        String   @id @default(uuid())
  token     String   @unique
  expire_at DateTime @default(now())
}

model RecordedActivity {
  id            String       @id @default(uuid())
  message       String
  url           String
  activity_type ActivityType

  created_at DateTime @default(now())

  // Relations
  account      Users  @relation(references: [username], fields: [account_name], onDelete: Cascade)
  account_name String
}
