generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model registration {
  id         String   @id
  email      String   @unique(map: "Registration_email_key")
  token      String   @unique(map: "Registration_token_key")
  created_at DateTime @default(now())
}

model report {
  id             String           @id
  submitted_by   String
  message        String
  type           report_type
  follow_up      report_follow_up
  follow_up_name String
  status         report_status    @default(Hold)
  location       String?
  image          String
  created_at     DateTime         @default(now())
  report_date    DateTime         @default(now())
  due_date       DateTime         @default(now())
  pic_name       String
}

model users {
  id         String     @id
  email      String     @unique(map: "Users_email_key")
  username   String     @unique(map: "Users_username_key")
  password   String
  role       users_role
  created_at DateTime   @default(now())
}

enum report_type {
  VR
  Safety
  Abnormality
}

enum report_follow_up {
  Guru
  Siswa
  Vendor
}

enum users_role {
  Guru
  Siswa
  Vendor
}

enum report_status {
  NotStarted
  InProcess
  Complete
  Hold
}
