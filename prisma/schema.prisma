generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enum
enum AccountType {
  Guru
  Siswa
  Vendor
  Tukang
}

enum ReportType {
  VR
  Safety
  Abnormality
}

enum ReportStatus {
  NotStarted
  InProcess
  Complete
  Hold
}

// Database model
model Users {
  id       String      @id @default(uuid())
  email    String      @unique
  username String      @unique
  password String
  role     AccountType

  created_at DateTime @default(now())

  // Relation
}

model Report_PIC {
  id   String @id @default(uuid())
  name String @unique

  created_at DateTime @default(now())

  // Relation
  reports Report[]
}

model Report_Location {
  id       String @id @default(uuid())
  location String @unique

  created_at DateTime @default(now())

  // Relation
  reports Report[]
}

model Report {
  id              String       @id @default(uuid())
  submitted_by    String
  message         String
  type            ReportType
  follow_up       AccountType?
  follow_up_name  String?
  status          ReportStatus @default(NotStarted)
  image           String?
  detail_location String?

  created_at DateTime @default(now())

  report_date DateTime  @default(now())
  due_date    DateTime?

  // Relations
  responsible_pic Report_PIC? @relation(references: [name], fields: [pic_name], onDelete: SetNull)
  pic_name        String?

  report_location Report_Location? @relation(references: [location], fields: [location], onDelete: SetNull)
  location        String?
}

model VerifiedCaptcha {
  id        String   @id @default(uuid())
  token     String   @unique
  expire_at DateTime @default(now())
}
